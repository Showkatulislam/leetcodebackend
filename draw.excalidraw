      "text": "                    ┌──────────────────────┐\n                    │        User          │\n                    ├──────────────────────┤\n                    │ id                   │\n                    │ username             │\n                    │ email                │\n                    │ password             │\n                    │ role                 │\n                    │ isVerified           │\n                    │ isActive             │\n                    └──────────┬───────────┘\n                               │\n             ┌─────────────────┼─────────────────┐\n             │                 │                 │\n             ▼                 ▼                 ▼\n    ┌────────────────┐ ┌────────────────┐ ┌─────────────────────┐\n    │ RefreshToken   │ │ PasswordReset  │ │ EmailVerification   │\n    ├────────────────┤ ├────────────────┤ ├─────────────────────┤\n    │ id             │ │ id             │ │ id                  │\n    │ tokenHash      │ │ tokenHash      │ │ tokenHash           │\n    │ userId         │ │ userId         │ │ userId              │\n    │ expiresAt      │ │ expiresAt      │ │ expiresAt           │\n    │ revokedAt      │ │ usedAt         │ │ usedAt              │\n    └────────────────┘ └────────────────┘ └─────────────────────┘",
      "fontSize": 10.606697582893116,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                    ┌──────────────────────┐\n                    │        User          │\n                    ├──────────────────────┤\n                    │ id                   │\n                    │ username             │\n                    │ email                │\n                    │ password             │\n                    │ role                 │\n                    │ isVerified           │\n                    │ isActive             │\n                    └──────────┬───────────┘\n                               │\n             ┌─────────────────┼─────────────────┐\n             │                 │                 │\n             ▼                 ▼                 ▼\n    ┌────────────────┐ ┌────────────────┐ ┌─────────────────────┐\n    │ RefreshToken   │ │ PasswordReset  │ │ EmailVerification   │\n    ├────────────────┤ ├────────────────┤ ├─────────────────────┤\n    │ id             │ │ id             │ │ id                  │\n    │ tokenHash      │ │ tokenHash      │ │ tokenHash           │\n    │ userId         │ │ userId         │ │ userId              │\n    │ expiresAt      │ │ expiresAt      │ │ expiresAt           │\n    │ revokedAt      │ │ usedAt         │ │ usedAt              │\n    └────────────────┘ └────────────────┘ └─────────────────────┘",
